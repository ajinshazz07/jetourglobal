# Copy to .env.local (never commit real values).
# HTTPS endpoint of the client's approved CRM / email service / secure database API.
# Leave empty and the form will show an error — it never fakes a successful submission.
ENQUIRY_WEBHOOK_URL=
# Optional bearer token for the endpoint above.
ENQUIRY_WEBHOOK_TOKEN=
# Optional: production origin, e.g. https://www.yourdomain.com
ALLOWED_ORIGIN=
